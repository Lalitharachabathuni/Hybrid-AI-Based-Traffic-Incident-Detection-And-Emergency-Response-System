# Copy this file to ".env" and fill in values as needed.
# Every variable below is OPTIONAL -- the system runs fully without any of them
# (template-based reports + console/log/DB notifications only).

# --- Optional: enables real email dispatch in backend/notification.py ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# ALERT_EMAIL_TO=dispatch_center@example.com

# --- Optional: enables Gemini-powered narrative report rewriting ---
# Requires: pip install google-generativeai
# GEMINI_API_KEY=your_gemini_api_key
